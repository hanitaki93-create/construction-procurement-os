{
  "name": "construction-procurement-os",
  "version": "0.0.0-b01",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "architecture:check": "node scripts/check-boundaries.mjs && node scripts/check-database-public-surface.mjs",
    "build": "pnpm -r --if-present build",
    "db:integration": "pnpm --filter @cpos/database-core test:integration",
    "db:migrate": "pnpm --filter @cpos/database-core build && pnpm --filter @cpos/database-core db migrate",
    "db:scan": "pnpm --filter @cpos/database-core build && pnpm --filter @cpos/database-core db scan",
    "db:status": "pnpm --filter @cpos/database-core build && pnpm --filter @cpos/database-core db status",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "infra:destroy": "node scripts/local-infra.mjs destroy",
    "infra:down": "node scripts/local-infra.mjs down",
    "infra:status": "node scripts/local-infra.mjs status",
    "infra:up": "node scripts/local-infra.mjs up",
    "infra:wait": "node scripts/local-infra.mjs wait",
    "lint": "eslint .",
    "manifests:check": "node scripts/check-root-manifest.mjs && pnpm --filter @cpos/invariant-compiler check",
    "object:integration": "pnpm --filter @cpos/object-store test:integration",
    "smoke": "node scripts/smoke-api.mjs && node apps/worker/dist/main.js --check",
    "start:api": "pnpm --filter @cpos/api start",
    "start:worker": "pnpm --filter @cpos/worker start",
    "test": "node --test scripts/lib/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm manifests:check && pnpm test && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
