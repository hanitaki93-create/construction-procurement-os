# Safe local development defaults only. Do not place real credentials here.
APP_ENV=development
HOST=127.0.0.1
PORT=3001
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
TRUST_PROXY=false
LOG_LEVEL=info
BUILD_ID=development
RELEASE_ID=unreleased
SOURCE_COMMIT=unknown

# B02 isolated development product shell. Never enable this in production.
CPOS_DEMO_MODE=false

# B01/B02 local technical infrastructure. These placeholders are not production credentials.
DATABASE_URL=postgresql://cpos:cpos-local-only@127.0.0.1:5432/cpos
OBJECT_STORE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=cpos-local
OBJECT_STORE_SECRET_ACCESS_KEY=cpos-local-secret
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
